# Hub맥 Docker 로컬 실행용 예시 — 실제 값은 Git에서 제외되는 .env에만 둡니다.
# 아래 두 비밀값은 `openssl rand -hex 32` 이상으로 생성합니다.
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
JWT_SECRET=replace-with-at-least-32-random-characters

# 선택: Supabase Storage를 실제로 시험할 때만 설정합니다.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role-key>

# 선택: 카카오 웹 로그인 실제 왕복을 시험할 때만 설정합니다.
# 세 값은 카카오 개발자 콘솔 등록값과 글자 단위로 같아야 합니다.
# KAKAO_REST_API_KEY=<rest-api-key>
# KAKAO_CLIENT_SECRET=<client-secret>
# KAKAO_APP_ID=<numeric-app-id>
KAKAO_REDIRECT_URIS=["http://localhost:3000/api/auth/kakao/callback"]
# KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
